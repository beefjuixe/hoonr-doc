  "info": {
    "title": "Hoonr Integrations API",
    "description": "M2M ATS/VMS APIs. Auth: POST /auth/service-login on auth-backend, then Authorize with JWT, x-service: refold, x-tenant: <subDomain>.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "JWT from auth-backend POST /auth/service-login"
      },
      "x-service": {
        "type": "apiKey",
        "in": "header",
        "name": "x-service",
        "description": "refold"
      },
      "x-tenant": {
        "type": "apiKey",
        "in": "header",
        "name": "x-tenant",
        "description": "Tenant subdomain"
      }
    },
    "schemas": {
      "Countries": {
        "type": "object",
        "properties": {}
      },
      "Cities": {
        "type": "object",
        "properties": {}
      },
      "CreateIntegrationJobDto": {
        "type": "object",
        "properties": {
          "jobTitle": {
            "type": "string",
            "minLength": 1,
            "example": "Senior Software Engineer"
          },
          "jobDescription": {
            "type": "string",
            "minLength": 1,
            "example": "Job description text"
          },
          "jobDescriptionHtml": {
            "type": "string"
          },
          "jobId": {
            "type": "string",
            "description": "External ATS/VMS job id (idempotency key). Reused on upsert."
          },
          "recruiterId": {
            "type": "number",
            "description": "Hoonr recruiter user id. Falls back to first tenant admin if omitted."
          },
          "assignedToUserId": {
            "type": "number"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "otherSkills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "experienceLevel": {
            "type": "string"
          },
          "minExperience": {
            "type": "number"
          },
          "maxExperience": {
            "type": "number"
          },
          "jobType": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "example": "integration"
          },
          "clientName": {
            "type": "string"
          },
          "jobStatus": {
            "type": "string"
          },
          "postedDate": {
            "type": "string"
          },
          "hiringManagerName": {
            "type": "string"
          },
          "hiringManagerEmail": {
            "type": "string"
          },
          "hiringManagerMobile": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "jobTitle",
          "jobDescription"
        ]
      },
      "UpdateIntegrationJobDto": {
        "type": "object",
        "properties": {
          "jobTitle": {
            "type": "string"
          },
          "jobDescription": {
            "type": "string"
          },
          "jobDescriptionHtml": {
            "type": "string"
          },
          "jobType": {
            "type": "string"
          },
          "clientName": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "otherSkills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "experienceLevel": {
            "type": "string"
          },
          "jobStatus": {
            "type": "string"
          },
          "hiringManagerName": {
            "type": "string"
          },
          "hiringManagerEmail": {
            "type": "string"
          },
          "hiringManagerMobile": {
            "type": "string"
          },
          "assignedToUserId": {
            "type": "number"
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "Jobs": {
        "type": "object",
        "properties": {}
      },
      "CreateIntegrationCandidateDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Jane Doe"
          },
          "email": {
            "type": "string",
            "example": "jane.doe@example.com"
          },
          "linkedIn_link": {
            "type": "string",
            "example": "https://www.linkedin.com/in/jane-doe"
          },
          "year_of_experience": {
            "type": "number",
            "minimum": 0,
            "example": 7
          },
          "title": {
            "type": "string",
            "example": "Senior Software Engineer"
          },
          "phone": {
            "type": "string",
            "example": "+1-555-0100"
          },
          "country": {
            "type": "string",
            "example": "United States"
          },
          "state": {
            "type": "string",
            "example": "California"
          },
          "city": {
            "type": "string",
            "example": "San Francisco"
          },
          "workHistoryWithEducation": {
            "type": "object",
            "properties": {
              "education": {
                "required": true,
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "workHistory": {
                "required": true,
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        "required": [
          "name",
          "email",
          "linkedIn_link",
          "year_of_experience",
          "workHistoryWithEducation"
        ]
      },
      "SearchIntegrationCandidatesDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "string",
            "description": "1-based page (20 per page)",
            "example": "1"
          },
          "queryData": {
            "type": "string",
            "description": "Free-text search (name, email, phone, boolean skill queries). Preferred for ATS enrichment by email/name.",
            "example": "jane.doe@example.com"
          },
          "skills": {
            "type": "string",
            "description": "Skill category filter (matches skills.skillCategory)",
            "example": "Cloud"
          },
          "skillFinal": {
            "type": "string",
            "description": "Exact skill name (e.g. AWS). Prefer over skills for specific skills.",
            "example": "AWS"
          },
          "country": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "experience_level": {
            "type": "string",
            "example": "Senior"
          },
          "domain": {
            "type": "string"
          },
          "roleType": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Candidate status filter"
          },
          "addedWith": {
            "type": "string",
            "description": "How the candidate was added (e.g. Join-hoonr)"
          }
        }
      },
      "IntegrationSubmissionStatusDto": {
        "type": "object",
        "properties": {
          "submissionId": {
            "type": "number",
            "minimum": 1,
            "example": 42,
            "description": "Hoonr CandidateSubmission primary id"
          },
          "status": {
            "enum": [
              "CREATED",
              "SUBMITTING",
              "SUBMITTED",
              "SUBMISSION_FAILED"
            ],
            "type": "string",
            "example": "SUBMITTED"
          },
